            {
                level: "Vận dụng",
                q: "Rút gọn biểu thức: <span class='math-expr'>C = (2x + 1)<sup>2</sup> + (2x - 1)<sup>2</sup> - 8x<sup>2</sup></span>",
                options: [
                    "<span class='math-expr'>2</span>",
                    "<span class='math-expr'>0</span>",
                    "<span class='math-expr'>8x + 2</span>",
                    "<span class='math-expr'>-2</span>"
                ],
                correct: 0,
                explain: "Ta có (2x + 1)² = 4x² + 4x + 1 và (2x - 1)² = 4x² - 4x + 1. Cộng lại được 8x² + 2, trừ đi 8x² còn lại 2."
            },
            {
                level: "Vận dụng",
                q: "Rút gọn biểu thức: <span class='math-expr'>D = (2x + 3)<sup>2</sup> - (2x - 3)<sup>2</sup></span>",
                options: [
                    "<span class='math-expr'>24x</span>",
                    "<span class='math-expr'>12x</span>",
                    "<span class='math-expr'>18</span>",
                    "<span class='math-expr'>8x<sup>2</sup> + 18</span>"
                ],
                correct: 0,
                explain: "(2x + 3)² = 4x² + 12x + 9; (2x - 3)² = 4x² - 12x + 9. Lấy biểu thức trước trừ biểu thức sau: (4x² + 12x + 9) - (4x² - 12x + 9) = 24x."
            }
        ];

        // =========================================================================
        // 2. HỆ THỐNG ÂM THANH (WEB AUDIO API - KHÔNG CẦN FILE NGOÀI)
        // =========================================================================
        let audioCtx = null;
        let soundEnabled = true;

        function initAudio() {
            if (!audioCtx) {
                const AudioContext = window.AudioContext || window.webkitAudioContext;
                if (AudioContext) {
                    audioCtx = new AudioContext();
                }
            }
            if (audioCtx && audioCtx.state === 'suspended') {
                audioCtx.resume();
            }
        }

        function playSound(type) {
            if (!soundEnabled) return;
            try {
                initAudio();
                if (!audioCtx) return;

                const now = audioCtx.currentTime;
                if (type === 'correct') {
                    // Chuỗi nốt vui tươi (C5 - E5 - G5)
                    const freqs = [523.25, 659.25, 783.99];
                    freqs.forEach((f, idx) => {
                        const osc = audioCtx.createOscillator();
                        const gain = audioCtx.createGain();
                        osc.type = 'triangle';
                        osc.frequency.setValueAtTime(f, now + idx * 0.08);
                        gain.gain.setValueAtTime(0.22, now + idx * 0.08);
                        gain.gain.exponentialRampToValueAtTime(0.001, now + idx * 0.08 + 0.35);
                        osc.connect(gain);
                        gain.connect(audioCtx.destination);
                        osc.start(now + idx * 0.08);
                        osc.stop(now + idx * 0.08 + 0.36);
                    });
                } else if (type === 'wrong') {
                    // Âm trầm báo sai nhẹ nhàng
                    const osc = audioCtx.createOscillator();
                    const gain = audioCtx.createGain();
                    osc.type = 'sawtooth';
                    osc.frequency.setValueAtTime(220, now);
                    osc.frequency.linearRampToValueAtTime(140, now + 0.35);
                    gain.gain.setValueAtTime(0.18, now);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + 0.36);
                    osc.connect(gain);
                    gain.connect(audioCtx.destination);
                    osc.start(now);
                    osc.stop(now + 0.38);
                } else if (type === 'win') {
                    // Nhạc chúc mừng hoàn thành
                    const notes = [523.25, 659.25, 783.99, 1046.50];
                    notes.forEach((f, i) => {
                        const osc = audioCtx.createOscillator();
                        const gain = audioCtx.createGain();
                        osc.type = 'sine';
                        osc.frequency.setValueAtTime(f, now + i * 0.12);
                        gain.gain.setValueAtTime(0.25, now + i * 0.12);
                        gain.gain.exponentialRampToValueAtTime(0.001, now + i * 0.12 + 0.5);
                        osc.connect(gain);
                        gain.connect(audioCtx.destination);
                        osc.start(now + i * 0.12);
                        osc.stop(now + i * 0.12 + 0.52);
                    });
                }
            } catch (e) {
                console.warn("Audio error:", e);
            }
        }

        function toggleSound() {
            soundEnabled = !soundEnabled;
            const icon = document.getElementById('sound-icon');
            if (soundEnabled) {
                icon.className = "fa-solid fa-volume-high";
                playSound('correct');
            } else {
                icon.className = "fa-solid fa-volume-xmark text-slate-400";
            }
        }

        // =========================================================================
        // 3. HỆ THỐNG ZOOM THÔNG MINH (CHỐNG TRÀN & MẤT CHỮ KHI PHÓNG TO)
        // =========================================================================
        let currentZoom = 1.0;

        function changeZoom(delta) {
            currentZoom = Math.min(2.05, Math.max(0.85, Math.round((currentZoom + delta) * 100) / 100));
            applyZoom();
        }

        function resetZoom() {
            currentZoom = 1.0;
            applyZoom();
        }

        function applyZoom() {
            document.documentElement.style.setProperty('--zoom-scale', currentZoom);
            document.getElementById('zoom-level-text').textContent = Math.round(currentZoom * 100) + '%';

            // Khi phóng to >= 130%, tự động chuyển lưới đáp án sang 1 cột để chữ to rõ không bị chật
            const optionsGrid = document.getElementById('options-grid');
            if (optionsGrid) {
                if (currentZoom >= 1.3) {
                    optionsGrid.classList.remove('md:grid-cols-2');
                    optionsGrid.classList.add('grid-cols-1');
                } else {
                    optionsGrid.classList.add('md:grid-cols-2');
                }
            }
        }

        // =========================================================================
        // 4. LOGIC TRÒ CHƠI, ĐẢO ĐÁP ÁN & ĐỒNG HỒ BẤM GIỜ
        // =========================================================================
        let activeQuestions = [];
        let currentIndex = 0;
        let score = 0;
        let streak = 0;
        let maxStreak = 0;
        let answered = false;
        let currentStudentName = "";
        let currentStudentClass = "";
        let quizStartTime = 0;
        let elapsedSeconds = 0;
        let timerInterval = null;

        let stats = {
            "Nhận biết": { correct: 0, total: 10 },
            "Thông hiểu": { correct: 0, total: 6 },
            "Vận dụng": { correct: 0, total: 4 }
        };

        const STORAGE_KEY = "bui_duc_manh_hdt_records_v1";
        const WEBHOOK_KEY = "bui_duc_manh_hdt_webhook_v1";

        const happyStickers = ["🎉", "🥳", "🌟", "👏", "🏆", "🚀", "💯", "🔥"];
        const encourageStickers = ["💪", "🤔", "📖", "💡", "🌱"];

        function shuffleArray(arr) {
            const copy = [...arr];
            for (let i = copy.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [copy[i], copy[j]] = [copy[j], copy[i]];
            }
            return copy;
        }

        // Chuẩn bị bộ câu hỏi: giữ tiến trình từ dễ -> khó (NB -> TH -> VD) nhưng ĐẢO ĐÁP ÁN A, B, C, D ngẫu nhiên
        function prepareShuffledQuestions() {
            return rawQuestions.map(item => {
                const indexedOptions = item.options.map((optText, idx) => ({
                    text: optText,
                    isCorrect: idx === item.correct
                }));
                const shuffledOpts = shuffleArray(indexedOptions);
                return {
                    level: item.level,
                    q: item.q,
                    options: shuffledOpts.map(o => o.text),
                    correctIndex: shuffledOpts.findIndex(o => o.isCorrect),
                    explain: item.explain
                };
            });
        }

        function startGame() {
            const nameInput = document.getElementById('student-name-input');
            const classInput = document.getElementById('student-class-input');
            const errorMsg = document.getElementById('name-error-msg');

            const nameVal = nameInput.value.trim();
            const classVal = classInput.value.trim() || "8A";

            if (!nameVal) {
                errorMsg.classList.remove('hidden');
                nameInput.focus();
                nameInput.classList.add('border-rose-500');
                return;
            }

            errorMsg.classList.add('hidden');
            nameInput.classList.remove('border-rose-500');

            currentStudentName = nameVal;
            currentStudentClass = classVal;
            initAudio();

            // Reset chỉ số trò chơi
            activeQuestions = prepareShuffledQuestions();
            currentIndex = 0;
            score = 0;
            streak = 0;
            maxStreak = 0;
            stats = {
                "Nhận biết": { correct: 0, total: 10 },
                "Thông hiểu": { correct: 0, total: 6 },
                "Vận dụng": { correct: 0, total: 4 }
            };

            document.getElementById('display-student-info').textContent = `${currentStudentName} (${currentStudentClass})`;
            document.getElementById('start-screen').classList.add('hidden');
            document.getElementById('result-screen').classList.add('hidden');
            const quizScreen = document.getElementById('quiz-screen');
            quizScreen.classList.remove('hidden');
            quizScreen.classList.add('flex');

            updateScoreUI();
            startTimer();
            renderQuestion();
        }

        function startTimer() {
            stopTimer();
            quizStartTime = Date.now();
            elapsedSeconds = 0;
            updateTimerDisplay();
            timerInterval = setInterval(() => {
                elapsedSeconds = Math.floor((Date.now() - quizStartTime) / 1000);
                updateTimerDisplay();
            }, 1000);
        }

        function stopTimer() {
            if (timerInterval) {
                clearInterval(timerInterval);
                timerInterval = null;
            }
        }

        function formatDuration(sec) {
            const m = Math.floor(sec / 60).toString().padStart(2, '0');
            const s = (sec % 60).toString().padStart(2, '0');
            return `${m}:${s}`;
        }

        function updateTimerDisplay() {
            const el = document.getElementById('timer-display');
            if (el) el.textContent = formatDuration(elapsedSeconds);
        }

        function restartSameStudent() {
            startGame();
        }

        function backToStartForNextStudent() {
            stopTimer();
            document.getElementById('student-name-input').value = "";
            document.getElementById('result-screen').classList.add('hidden');
            document.getElementById('start-screen').classList.remove('hidden');
            setTimeout(() => document.getElementById('student-name-input').focus(), 100);
        }

        function renderQuestion() {
            answered = false;
            const qObj = activeQuestions[currentIndex];

            // Cập nhật tiến trình
            const qNum = currentIndex + 1;
            const pct = Math.round((qNum / activeQuestions.length) * 100);
            document.getElementById('current-q-num').textContent = qNum;
            document.getElementById('progress-percent').textContent = pct + '%';
            document.getElementById('progress-bar').style.width = pct + '%';

            // Badge mức độ
            const badge = document.getElementById('level-badge');
            badge.textContent = `Mức độ: ${qObj.level}`;
            if (qObj.level === "Nhận biết") {
                badge.className = "scalable-badge px-3 py-1 rounded-xl font-extrabold bg-emerald-100 text-emerald-800";
            } else if (qObj.level === "Thông hiểu") {
                badge.className = "scalable-badge px-3 py-1 rounded-xl font-extrabold bg-amber-100 text-amber-800";
            } else {
                badge.className = "scalable-badge px-3 py-1 rounded-xl font-extrabold bg-rose-100 text-rose-800";
            }

            // Nội dung câu hỏi
            document.getElementById('question-text').innerHTML = qObj.q;

            // Render 4 đáp án A, B, C, D
            const letters = ["A", "B", "C", "D"];
            const grid = document.getElementById('options-grid');
            grid.innerHTML = "";

            qObj.options.forEach((optHtml, idx) => {
                const btn = document.createElement('button');
                btn.className = "option-btn w-full text-left p-3.5 sm:p-4 rounded-2xl border-2 border-slate-200 bg-white hover:border-indigo-400 hover:bg-indigo-50/40 flex items-center gap-3.5 shadow-sm";
                btn.onclick = () => handleAnswer(idx, btn);
                btn.innerHTML = `
                    <span class="w-9 h-9 sm:w-10 sm:h-10 shrink-0 rounded-xl bg-indigo-100 text-indigo-800 font-black flex items-center justify-center text-base sm:text-lg option-letter">
                        ${letters[idx]}
                    </span>
                    <span class="scalable-option font-bold text-slate-800 flex-1">${optHtml}</span>
                `;
                grid.appendChild(btn);
            });

            // Ẩn khung phản hồi
            document.getElementById('feedback-box').classList.add('hidden');
            applyZoom();
        }

        function handleAnswer(selectedIndex, selectedBtn) {
            if (answered) return;
            answered = true;

            const qObj = activeQuestions[currentIndex];
            const isCorrect = selectedIndex === qObj.correctIndex;
            const allButtons = document.querySelectorAll('#options-grid .option-btn');

            allButtons.forEach((btn, idx) => {
                btn.disabled = true;
                const letterSpan = btn.querySelector('.option-letter');
                if (idx === qObj.correctIndex) {
                    btn.classList.remove('border-slate-200', 'bg-white');
                    btn.classList.add('border-emerald-500', 'bg-emerald-50', 'ring-2', 'ring-emerald-300');
                    letterSpan.classList.remove('bg-indigo-100', 'text-indigo-800');
                    letterSpan.classList.add('bg-emerald-500', 'text-white');
                } else if (idx === selectedIndex && !isCorrect) {
                    btn.classList.remove('border-slate-200', 'bg-white');
                    btn.classList.add('border-rose-500', 'bg-rose-50', 'animate-shake');
                    letterSpan.classList.remove('bg-indigo-100', 'text-indigo-800');
                    letterSpan.classList.add('bg-rose-500', 'text-white');
                } else {
                    btn.classList.add('opacity-60');
                }
            });

            const fbBox = document.getElementById('feedback-box');
            const fbSticker = document.getElementById('feedback-sticker');
            const fbTitle = document.getElementById('feedback-title');
            const fbExplain = document.getElementById('feedback-explanation');

            fbBox.classList.remove('hidden', 'bg-emerald-50', 'border-emerald-300', 'bg-rose-50', 'border-rose-300');

            if (isCorrect) {
                playSound('correct');
                streak++;
                if (streak > maxStreak) maxStreak = streak;
                const bonus = streak >= 3 ? 2 : 0;
                score += (10 + bonus);
                stats[qObj.level].correct++;

                fbBox.classList.add('bg-emerald-50', 'border-emerald-300');
                fbSticker.textContent = happyStickers[Math.floor(Math.random() * happyStickers.length)];
                fbTitle.textContent = streak >= 3 ? `Tuyệt đỉnh! Chuỗi ${streak} câu đúng liên tiếp (+${10 + bonus} điểm)` : "Chính xác! Giỏi lắm (+10 điểm)";
                fbTitle.className = "font-black text-base sm:text-lg text-emerald-800";

                // Bắn pháo giấy mini khi trả lời đúng
                if (typeof confetti === 'function') {
                    confetti({ particleCount: 35, spread: 55, origin: { y: 0.75 } });
                }
            } else {
                playSound('wrong');
                streak = 0;
                fbBox.classList.add('bg-rose-50', 'border-rose-300');
                fbSticker.textContent = encourageStickers[Math.floor(Math.random() * encourageStickers.length)];
                fbTitle.textContent = "Chưa chính xác rồi! Xem gợi ý bên dưới nhé:";
                fbTitle.className = "font-black text-base sm:text-lg text-rose-800";
            }

            fbExplain.textContent = qObj.explain;
            document.getElementById('next-btn').innerHTML = currentIndex === activeQuestions.length - 1
                ? `<span>Xem kết quả</span> <i class="fa-solid fa-flag-checkered"></i>`
                : `<span>Câu tiếp theo</span> <i class="fa-solid fa-arrow-right"></i>`;

            updateScoreUI();

            // Tự động cuộn mượt xuống phần giải thích để học sinh thấy rõ khi đang bật Zoom lớn
            setTimeout(() => {
                fbBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            }, 100);
        }

        function updateScoreUI() {
            document.getElementById('score-display').textContent = score;
            const streakBox = document.getElementById('streak-box');
            if (streak >= 2) {
                streakBox.classList.remove('hidden');
                streakBox.classList.add('flex');
                document.getElementById('streak-count').textContent = streak;
            } else {
                streakBox.classList.add('hidden');
                streakBox.classList.remove('flex');
            }
        }

        function nextQuestion() {
            if (currentIndex < activeQuestions.length - 1) {
                currentIndex++;
                renderQuestion();
            } else {
                showResults();
            }
        }

        function showResults() {
            stopTimer();
            playSound('win');
            document.getElementById('quiz-screen').classList.add('hidden');
            document.getElementById('quiz-screen').classList.remove('flex');
            document.getElementById('result-screen').classList.remove('hidden');

            const totalCorrect = stats["Nhận biết"].correct + stats["Thông hiểu"].correct + stats["Vận dụng"].correct;
            document.getElementById('result-student-name').textContent = `${currentStudentName} - Lớp ${currentStudentClass}`;
            document.getElementById('final-score').textContent = score;
            document.getElementById('final-correct').textContent = `${totalCorrect}/20`;
            document.getElementById('final-streak').textContent = `${maxStreak} 🔥`;

            document.getElementById('stat-time').textContent = formatDuration(elapsedSeconds);
            document.getElementById('stat-nb').textContent = `${stats["Nhận biết"].correct}/10`;
            document.getElementById('stat-th').textContent = `${stats["Thông hiểu"].correct}/6`;
            document.getElementById('stat-vd').textContent = `${stats["Vận dụng"].correct}/4`;

            // Lưu kết quả học sinh vào bộ nhớ & gửi Google Sheet (nếu có cấu hình Webhook)
            saveAndSyncStudentResult(totalCorrect);
            renderResultRankingTable();

            const resTitle = document.getElementById('result-title');
            const resTrophy = document.getElementById('result-trophy');
            if (totalCorrect >= 17) {
                resTitle.textContent = "XUẤT SẮC! BẬC THẦY HẰNG ĐẲNG THỨC!";
                resTrophy.textContent = "🏆";
            } else if (totalCorrect >= 12) {
                resTitle.textContent = "LÀM TỐT LẮM! TIẾP TỤC PHÁT HUY NHÉ!";
                resTrophy.textContent = "🥇";
            } else {
                resTitle.textContent = "CỐ GẮNG LÊN! ÔN LẠI CÔNG THỨC NÀO!";
                resTrophy.textContent = "🌟";
            }

            if (typeof confetti === 'function') {
                confetti({ particleCount: 100, spread: 80, origin: { y: 0.6 } });
            }
        }

        // =========================================================================
        // 5. QUẢN LÝ BẢNG XẾP HẠNG, GỬI ZALO PHỤ HUYNH & XUẤT GOOGLE SHEET
        // =========================================================================
        function getStudentRecords() {
            try {
                return JSON.parse(localStorage.getItem(STORAGE_KEY)) || [];
            } catch {
                return [];
            }
        }

        function getSortedRecords() {
            const records = getStudentRecords();
            // Sắp xếp: 1. Số câu đúng giảm dần -> 2. Thời gian hoàn thành (giây) tăng dần
            return records.sort((a, b) => {
                if (b.correct !== a.correct) {
                    return b.correct - a.correct;
                }
                const durA = typeof a.durationSec === 'number' ? a.durationSec : 999999;
                const durB = typeof b.durationSec === 'number' ? b.durationSec : 999999;
                return durA - durB;
            });
        }

        function getRankBadge(index) {
            if (index === 0) return '<span class="text-lg" title="Hạng Nhất">🥇</span>';
            if (index === 1) return '<span class="text-lg" title="Hạng Nhì">🥈</span>';
            if (index === 2) return '<span class="text-lg" title="Hạng Ba">🥉</span>';
            return `<span class="font-extrabold text-slate-500">#${index + 1}</span>`;
        }

        function updateRecordCountBadge() {
            const records = getStudentRecords();
            document.getElementById('record-count-badge').textContent = records.length;
        }

        function saveAndSyncStudentResult(totalCorrect) {
            const now = new Date();
            const timeStr = now.toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' }) + ' ' + now.toLocaleDateString('vi-VN');
            const durationFormatted = formatDuration(elapsedSeconds);
            
            const record = {
                time: timeStr,
                name: currentStudentName,
                className: currentStudentClass,
                score: score,
                correct: totalCorrect,
                correctText: `${totalCorrect}/20`,
                durationSec: elapsedSeconds,
                durationText: durationFormatted,
                nb: `${stats["Nhận biết"].correct}/10`,
                th: `${stats["Thông hiểu"].correct}/6`,
                vd: `${stats["Vận dụng"].correct}/4`
            };

            const records = getStudentRecords();
            records.push(record);
            localStorage.setItem(STORAGE_KEY, JSON.stringify(records));
            updateRecordCountBadge();

            // Nếu giáo viên đã cấu hình Google Apps Script Webhook, gửi dữ liệu trực tiếp
            const webhookUrl = localStorage.getItem(WEBHOOK_KEY);
            const syncBanner = document.getElementById('sync-status-banner');
            if (webhookUrl && webhookUrl.startsWith('https://')) {
                syncBanner.innerHTML = `<i class="fa-solid fa-spinner fa-spin text-indigo-600"></i> <span>Đang gửi kết quả lên Google Sheet của Thầy Bùi Đức Mạnh...</span>`;
                fetch(webhookUrl, {
                    method: 'POST',
                    mode: 'no-cors',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(record)
                }).then(() => {
                    syncBanner.innerHTML = `<i class="fa-solid fa-cloud-arrow-up text-emerald-600"></i> <span>Đã đồng bộ tự động lên Google Sheet & cập nhật Bảng xếp hạng!</span>`;
                }).catch(() => {
                    syncBanner.innerHTML = `<i class="fa-solid fa-circle-check text-emerald-600"></i> <span>Đã lưu vào Bảng xếp hạng trên máy!</span>`;
                });
            } else {
                syncBanner.innerHTML = `<i class="fa-solid fa-circle-check text-emerald-600"></i> <span>Đã cập nhật vào Bảng xếp hạng lớp (${records.length} học sinh)!</span>`;
            }
        }

        function renderResultRankingTable() {
            const sorted = getSortedRecords();
            const tbody = document.getElementById('result-ranking-tbody');
            if (!tbody) return;

            tbody.innerHTML = sorted.map((r, index) => {
                const isCurrent = (r.name === currentStudentName && r.durationSec === elapsedSeconds && r.score === score);
                const rowClass = isCurrent ? "bg-amber-100/70 text-indigo-950" : "hover:bg-slate-50";
                return `
                    <tr class="${rowClass}">
                        <td class="p-2.5 text-center">${getRankBadge(index)}</td>
                        <td class="p-2.5 font-extrabold">${escapeHTML(r.name)} ${isCurrent ? '<span class="text-[11px] bg-indigo-600 text-white px-1.5 py-0.5 rounded ml-1">Vừa xong</span>' : ''}</td>
                        <td class="p-2.5 text-slate-600">${escapeHTML(r.className)}</td>
                        <td class="p-2.5 text-center font-black text-emerald-700">${r.correctText}</td>
                        <td class="p-2.5 text-center font-extrabold text-sky-700">${r.durationText || '--:--'}</td>
                    </tr>
                `;
            }).join('');
        }

        function openLeaderboardModal() {
            renderLeaderboardTable();
            document.getElementById('leaderboard-modal').classList.remove('hidden');
        }

        function closeLeaderboardModal() {
            document.getElementById('leaderboard-modal').classList.add('hidden');
        }

        function renderLeaderboardTable() {
            const records = getSortedRecords();
            const tbody = document.getElementById('leaderboard-tbody');
            if (records.length === 0) {
                tbody.innerHTML = `<tr><td colspan="7" class="p-6 text-center text-slate-400 font-bold">Chưa có học sinh nào hoàn thành bài thi. Hãy nhập tên học sinh và bắt đầu làm bài nhé!</td></tr>`;
                return;
            }

            tbody.innerHTML = records.map((r, index) => `
                <tr class="hover:bg-indigo-50/50 transition ${index < 3 ? 'bg-amber-50/40' : ''}">
                    <td class="p-3 text-center">${getRankBadge(index)}</td>
                    <td class="p-3 font-extrabold text-indigo-950">${escapeHTML(r.name)}</td>
                    <td class="p-3 font-bold text-slate-600">${escapeHTML(r.className)}</td>
                    <td class="p-3 text-center font-black text-emerald-700">${r.correctText}</td>
                    <td class="p-3 text-center font-extrabold text-sky-700">${r.durationText || '--:--'}</td>
                    <td class="p-3 text-center text-xs text-slate-500 hidden sm:table-cell">${r.nb} | ${r.th} | ${r.vd}</td>
                    <td class="p-3 text-xs text-slate-400 hidden md:table-cell">${r.time}</td>
                </tr>
            `).join('');
        }

        function copyZaloReport(fromModal = false) {
            const sorted = getSortedRecords();
            if (sorted.length === 0) {
                showToast("Chưa có dữ liệu học sinh để tạo báo cáo!");
                return;
            }

            const today = new Date().toLocaleDateString('vi-VN');
            let report = `🏆 BẢNG VÀNG ÔN TẬP 7 HẰNG ĐẲNG THỨC (TOÁN 8) 🏆\n`;
            report += `👨‍🏫 Giáo viên hướng dẫn: Thầy Bùi Đức Mạnh\n`;
            report += `📅 Ngày: ${today} | Sĩ số tham gia: ${sorted.length} em\n`;
            report += `----------------------------------------\n`;

            sorted.forEach((r, idx) => {
                const medal = idx === 0 ? "🥇 Hạng 1:" : idx === 1 ? "🥈 Hạng 2:" : idx === 2 ? "🥉 Hạng 3:" : `${idx + 1}.`;
                report += `${medal} ${r.name} (${r.className}) — Đúng ${r.correctText} câu (Thời gian: ${r.durationText || '--:--'})\n`;
            });

            report += `----------------------------------------\n`;
            report += `👏 Thầy khen ngợi tinh thần học tập của các em! Phụ huynh cùng động viên các con ôn bài nhé!`;

            const tempArea = document.createElement("textarea");
            tempArea.value = report;
            document.body.appendChild(tempArea);
            tempArea.select();
            document.execCommand("copy");
            document.body.removeChild(tempArea);

            if (fromModal) {
                showToast("✅ Đã copy Bảng Vàng! Thầy mở nhóm Zalo Phụ huynh và bấm Dán (Ctrl+V) để gửi ngay nhé!");
            } else {
                const resToast = document.getElementById('result-toast-notify');
                if (resToast) {
                    resToast.textContent = "✅ Đã copy Bảng Vàng! Thầy chỉ cần mở nhóm Zalo Phụ huynh và bấm Dán (Ctrl+V) là gửi được ngay!";
                    resToast.classList.remove('hidden');
                    setTimeout(() => resToast.classList.add('hidden'), 4500);
                }
            }
        }

        // Xuất ra file CSV chuẩn UTF-8 BOM (mở trực tiếp bằng Google Sheet hoặc Excel không lỗi font tiếng Việt)
        function exportToCSV() {
            const records = getSortedRecords();
            if (records.length === 0) {
                showToast("Danh sách đang trống, chưa có dữ liệu để xuất!");
                return;
            }

            const headers = ["Hạng", "Họ và tên học sinh", "Lớp", "Số câu đúng", "Thời gian làm bài", "Điểm số", "Nhận biết", "Thông hiểu", "Vận dụng", "Thời điểm nộp", "Giáo viên hướng dẫn"];
            const rows = records.map((r, i) => [
                i + 1,
                `"${r.name.replace(/"/g, '""')}"`,
                `"${r.className.replace(/"/g, '""')}"`,
                `"${r.correctText}"`,
                `"${r.durationText || '--:--'}"`,
                r.score,
                `"${r.nb}"`,
                `"${r.th}"`,
                `"${r.vd}"`,
                `"${r.time}"`,
                `"Thầy Bùi Đức Mạnh"`
            ]);

            const csvContent = "\uFEFF" + [headers.join(","), ...rows.map(e => e.join(","))].join("\n");
            const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
            const url = URL.createObjectURL(blob);
            const link = document.createElement("a");
            const dateTag = new Date().toISOString().slice(0, 10);
            link.setAttribute("href", url);
            link.setAttribute("download", `Bang_Xep_Hang_7_Hang_Dang_Thuc_${dateTag}.csv`);
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            showToast("✅ Đã tải file CSV! Thầy có thể nhập (Import) trực tiếp file này vào Google Sheet.");
        }

        // Copy dạng bảng Tab-separated để dán thẳng (Ctrl+V) vào Google Sheet
        function copyTableForGoogleSheet() {
            const records = getSortedRecords();
            if (records.length === 0) {
                showToast("Danh sách đang trống!");
                return;
            }
            const headers = ["Hạng", "Họ và tên", "Lớp", "Số câu đúng", "Thời gian làm bài", "Điểm số", "Nhận biết", "Thông hiểu", "Vận dụng", "Thời điểm nộp"];
            const lines = records.map((r, i) => [i + 1, r.name, r.className, r.correctText, r.durationText || '--:--', r.score, r.nb, r.th, r.vd, r.time].join("\t"));
            const textToCopy = [headers.join("\t"), ...lines].join("\n");

            const tempArea = document.createElement("textarea");
            tempArea.value = textToCopy;
            document.body.appendChild(tempArea);
            tempArea.select();
            document.execCommand("copy");
            document.body.removeChild(tempArea);

            showToast("✅ Đã copy! Thầy mở Google Sheet và bấm Ctrl+V là dữ liệu tự động chia cột ngay.");
        }

        function clearStudentRecords() {
            const records = getStudentRecords();
            if (records.length === 0) return;
            // Không dùng confirm() theo quy định, dùng cơ chế bấm 2 lần xác nhận trên nút
            const btn = event.currentTarget;
            if (!btn.dataset.confirming) {
                btn.dataset.confirming = "true";
                btn.innerHTML = `<i class="fa-solid fa-triangle-exclamation"></i> Bấm lần nữa để xóa hết`;
                setTimeout(() => {
                    delete btn.dataset.confirming;
                    btn.innerHTML = `<i class="fa-solid fa-trash-can"></i> Xóa danh sách`;
                }, 3000);
                return;
            }
            localStorage.removeItem(STORAGE_KEY);
            delete btn.dataset.confirming;
            btn.innerHTML = `<i class="fa-solid fa-trash-can"></i> Xóa danh sách`;
            updateRecordCountBadge();
            renderLeaderboardTable();
            showToast("🗑️ Đã xóa sạch danh sách học sinh.");
        }

        function showToast(msg) {
            const toast = document.getElementById('export-toast');
            toast.textContent = msg;
            toast.classList.remove('hidden');
            setTimeout(() => toast.classList.add('hidden'), 4000);
        }

        // Cấu hình Webhook Google Apps Script
        function openSheetSettingsModal() {
            document.getElementById('webhook-url-input').value = localStorage.getItem(WEBHOOK_KEY) || "";
            document.getElementById('webhook-saved-msg').classList.add('hidden');
            document.getElementById('sheet-settings-modal').classList.remove('hidden');
        }

        function closeSheetSettingsModal() {
            document.getElementById('sheet-settings-modal').classList.add('hidden');
        }

        function saveWebhookUrl() {
            const val = document.getElementById('webhook-url-input').value.trim();
            localStorage.setItem(WEBHOOK_KEY, val);
            const msg = document.getElementById('webhook-saved-msg');
            msg.classList.remove('hidden');
            setTimeout(() => msg.classList.add('hidden'), 3000);
        }

        function escapeHTML(str) {
            return str.replace(/[&<>'"]/g, tag => ({
                '&': '&amp;',
                '<': '&lt;',
                '>': '&gt;',
                "'": '&#39;',
                '"': '&quot;'
            }[tag]));
        }

        // Khởi tạo khi tải trang
        window.onload = function() {
            updateRecordCountBadge();
            applyZoom();
        };
    </script>
