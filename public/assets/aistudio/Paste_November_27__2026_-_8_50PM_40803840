<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Chinh Phục 7 Hằng Đẳng Thức Đáng Nhớ - Thầy Bùi Đức Mạnh</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Canvas Confetti cho hiệu ứng chúc mừng -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
    <!-- Google Fonts: Nunito & Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&family=Nunito:wght@600;700;800;900&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --zoom-scale: 1;
        }

        body {
            font-family: 'Nunito', 'Inter', sans-serif;
            background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 50%, #db2777 100%);
            min-height: 100vh;
            margin: 0;
            padding: 0;
            overflow-x: hidden;
            overflow-y: auto;
        }

        /* Hiệu ứng chữ toán học chuẩn */
        .math-expr {
            font-family: 'Times New Roman', Times, serif;
            letter-spacing: 0.02em;
        }
        .math-expr sup {
            font-size: 0.68em;
            line-height: 0;
            position: relative;
            vertical-align: baseline;
            top: -0.45em;
        }

        /* Hệ thống Zoom thông minh chống tràn & mất chữ */
        .scalable-title {
            font-size: calc(1.25rem * var(--zoom-scale));
            line-height: 1.45;
            word-break: break-word;
        }
        .scalable-option {
            font-size: calc(1.1rem * var(--zoom-scale));
            line-height: 1.4;
            word-break: break-word;
        }
        .scalable-explanation {
            font-size: calc(0.95rem * var(--zoom-scale));
            line-height: 1.5;
        }
        .scalable-badge {
            font-size: calc(0.8rem * var(--zoom-scale));
        }

        /* Animations */
        @keyframes popIn {
            0% { transform: scale(0.8); opacity: 0; }
            70% { transform: scale(1.05); opacity: 1; }
            100% { transform: scale(1); opacity: 1; }
        }
        .animate-pop {
            animation: popIn 0.35s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
        }

        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            20%, 60% { transform: translateX(-8px); }
            40%, 80% { transform: translateX(8px); }
        }
        .animate-shake {
            animation: shake 0.4s ease-in-out;
        }

        @keyframes bounceCelebration {
            0%, 100% { transform: translateY(0) scale(1); }
            50% { transform: translateY(-10px) scale(1.12); }
        }
        .animate-celebrate {
            animation: bounceCelebration 0.6s ease infinite;
        }

        .option-btn {
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .option-btn:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px -4px rgba(79, 70, 229, 0.25);
        }
        .option-btn:active:not(:disabled) {
            transform: translateY(0);
        }

        /* Tùy chỉnh thanh cuộn */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: rgba(255, 255, 255, 0.15);
            border-radius: 10px;
        }
        ::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.45);
            border-radius: 10px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: rgba(255, 255, 255, 0.7);
        }
    </style>
</head>
<body class="text-slate-800 flex flex-col min-h-screen">

    <!-- THANH CÔNG CỤ TRÊN CÙNG (Ghim cố định để luôn bấm Zoom & Xem danh sách được) -->
    <header class="sticky top-0 z-50 bg-slate-900/90 backdrop-blur-md text-white px-3 py-2.5 shadow-lg border-b border-white/10">
        <div class="max-w-6xl mx-auto flex flex-wrap items-center justify-between gap-2">
            <!-- Logo & Tên tác giả -->
            <div class="flex items-center gap-2.5">
                <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-amber-400 to-orange-500 flex items-center justify-center text-slate-900 font-black text-lg shadow">
                    7
                </div>
                <div>
                    <h1 class="font-extrabold text-sm sm:text-base leading-tight text-amber-300">7 HẰNG ĐẲNG THỨC ĐÁNG NHỚ</h1>
                    <p class="text-xs text-slate-300 font-semibold">Thực hiện bởi <span class="text-white font-bold">Thầy Bùi Đức Mạnh</span></p>
                </div>
            </div>

            <!-- Bộ điều khiển Zoom (Phóng to chữ cho học sinh ngồi xa) -->
            <div class="flex items-center gap-1.5 bg-slate-800 px-2.5 py-1 rounded-xl border border-slate-700" title="Phóng to / Thu nhỏ cỡ chữ cho học sinh ngồi xa">
                <span class="text-xs text-slate-300 hidden md:inline font-bold mr-1"><i class="fa-solid fa-magnifying-glass"></i> Cỡ chữ:</span>
                <button onclick="changeZoom(-0.15)" class="w-8 h-8 rounded-lg bg-slate-700 hover:bg-slate-600 active:bg-slate-500 flex items-center justify-center font-black text-base transition" title="Thu nhỏ chữ">
                    <i class="fa-solid fa-minus"></i>
                </button>
                <span id="zoom-level-text" class="px-2 text-xs sm:text-sm font-extrabold text-amber-300 min-w-[3.2rem] text-center">100%</span>
                <button onclick="changeZoom(0.15)" class="w-8 h-8 rounded-lg bg-indigo-600 hover:bg-indigo-500 active:bg-indigo-400 flex items-center justify-center font-black text-base transition" title="Phóng to chữ">
                    <i class="fa-solid fa-plus"></i>
                </button>
                <button onclick="resetZoom()" class="px-2 py-1 rounded-lg bg-slate-700 hover:bg-slate-600 text-xs font-bold ml-0.5 transition" title="Mặc định 100%">
                    100%
                </button>
            </div>

            <!-- Các nút tiện ích: Âm thanh, Bảng xếp hạng / Google Sheet -->
            <div class="flex items-center gap-2">
                <button onclick="openLeaderboardModal()" class="px-3 py-1.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs sm:text-sm flex items-center gap-1.5 shadow transition">
                    <i class="fa-solid fa-ranking-star"></i>
                    <span class="hidden sm:inline">Bảng xếp hạng</span>
                    <span id="record-count-badge" class="bg-white text-emerald-800 text-xs font-black px-1.5 py-0.2 rounded-full">0</span>
                </button>
                <button onclick="openSheetSettingsModal()" class="p-2 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-700 text-sky-400 transition" title="Cấu hình đồng bộ Google Sheet">
                    <i class="fa-solid fa-gear"></i>
                </button>
                <button id="sound-toggle-btn" onclick="toggleSound()" class="p-2 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-700 text-amber-400 transition" title="Bật/Tắt âm thanh">
                    <i id="sound-icon" class="fa-solid fa-volume-high"></i>
                </button>
            </div>
        </div>
    </header>

    <!-- NỘI DUNG CHÍNH -->
    <main class="flex-1 flex items-center justify-center p-3 sm:p-5">
        
        <!-- 1. MÀN HÌNH BẮT ĐẦU (NHẬP TÊN HỌC SINH) -->
        <div id="start-screen" class="w-full max-w-2xl bg-white/95 backdrop-blur-md rounded-3xl shadow-2xl p-6 sm:p-8 border-4 border-white/50 animate-pop">
            <div class="text-center mb-6">
                <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-indigo-100 text-indigo-800 font-extrabold text-xs sm:text-sm mb-3">
                    <span>🎓 Toán Lớp 8</span>
                    <span>•</span>
                    <span>Thực hiện bởi Thầy Bùi Đức Mạnh</span>
                </div>
                <h2 class="text-2xl sm:text-4xl font-black text-transparent bg-clip-text bg-gradient-to-r from-indigo-600 via-purple-600 to-pink-600 mb-2">
                    ĐẤU TRƯỜNG HẰNG ĐẲNG THỨC
                </h2>
                <p class="text-slate-600 font-semibold text-sm sm:text-base">
                    Ôn tập chiều xuôi & chiều ngược 7 hằng đẳng thức đáng nhớ
                </p>
            </div>

            <!-- Thống kê cấu trúc đề -->
            <div class="grid grid-cols-3 gap-2.5 sm:gap-4 mb-6 text-center">
                <div class="bg-emerald-50 border-2 border-emerald-200 rounded-2xl p-3">
                    <div class="text-xl sm:text-2xl font-black text-emerald-600">10 Câu</div>
                    <div class="text-xs sm:text-sm font-bold text-emerald-800">Nhận biết</div>
                    <div class="text-[11px] text-emerald-600 mt-0.5">Công thức xuôi & ngược</div>
                </div>
                <div class="bg-amber-50 border-2 border-amber-200 rounded-2xl p-3">
                    <div class="text-xl sm:text-2xl font-black text-amber-600">6 Câu</div>
                    <div class="text-xs sm:text-sm font-bold text-amber-800">Thông hiểu</div>
                    <div class="text-[11px] text-amber-600 mt-0.5">Áp dụng biến cơ bản x</div>
                </div>
                <div class="bg-rose-50 border-2 border-rose-200 rounded-2xl p-3">
                    <div class="text-xl sm:text-2xl font-black text-rose-600">4 Câu</div>
                    <div class="text-xs sm:text-sm font-bold text-rose-800">Vận dụng</div>
                    <div class="text-[11px] text-rose-600 mt-0.5">Rút gọn biểu thức (2x)</div>
                </div>
            </div>

            <!-- Form nhập thông tin học sinh -->
            <div class="bg-slate-50 p-4 sm:p-5 rounded-2xl border border-slate-200 mb-6 space-y-3.5">
                <div>
                    <label for="student-name-input" class="block text-sm font-extrabold text-slate-700 mb-1">
                        <i class="fa-solid fa-user-graduate text-indigo-600 mr-1"></i> Họ và tên học sinh <span class="text-rose-500">*</span>
                    </label>
                    <input type="text" id="student-name-input" placeholder="Ví dụ: Nguyễn Văn An..." 
                        class="w-full px-4 py-3 rounded-xl border-2 border-slate-300 focus:border-indigo-500 focus:outline-none font-bold text-base sm:text-lg text-slate-800 transition"
                        onkeypress="if(event.key === 'Enter') startGame()">
                </div>
                <div>
                    <label for="student-class-input" class="block text-sm font-extrabold text-slate-700 mb-1">
                        <i class="fa-solid fa-users text-purple-600 mr-1"></i> Lớp / Tổ
                    </label>
                    <input type="text" id="student-class-input" placeholder="Ví dụ: 8A1 (hoặc Tổ 1)" value="8A"
                        class="w-full px-4 py-2.5 rounded-xl border-2 border-slate-300 focus:border-indigo-500 focus:outline-none font-bold text-base text-slate-800 transition"
                        onkeypress="if(event.key === 'Enter') startGame()">
                </div>
                <p id="name-error-msg" class="hidden text-rose-600 text-sm font-bold">
                    <i class="fa-solid fa-circle-exclamation"></i> Em vui lòng nhập Họ và tên trước khi bắt đầu nhé!
                </p>
            </div>

            <button onclick="startGame()" class="w-full py-4 rounded-2xl bg-gradient-to-r from-indigo-600 via-purple-600 to-pink-600 hover:from-indigo-500 hover:to-pink-500 text-white font-black text-lg sm:text-xl shadow-xl shadow-indigo-500/30 transform hover:-translate-y-0.5 active:translate-y-0 transition flex items-center justify-center gap-3">
                <i class="fa-solid fa-play"></i> BẮT ĐẦU CHINH PHỤC (20 CÂU)
            </button>
        </div>

        <!-- 2. MÀN HÌNH CHƠI TRẮC NGHIỆM (TỐI ƯU 1 MÀN HÌNH + ZOOM LINH HOẠT) -->
        <div id="quiz-screen" class="hidden w-full max-w-5xl bg-white/95 backdrop-blur-md rounded-3xl shadow-2xl p-4 sm:p-6 border-4 border-white/50 flex-col gap-4">
            
            <!-- Thanh trạng thái học sinh, tiến độ, đồng hồ & điểm số -->
            <div class="flex flex-wrap items-center justify-between gap-2 pb-3 border-b border-slate-200">
                <div class="flex items-center gap-2 flex-wrap">
                    <span class="px-3 py-1 rounded-xl bg-indigo-100 text-indigo-800 font-extrabold text-xs sm:text-sm">
                        <i class="fa-solid fa-user"></i> <span id="display-student-info">Học sinh</span>
                    </span>
                    <span id="level-badge" class="scalable-badge px-3 py-1 rounded-xl font-extrabold bg-emerald-100 text-emerald-800">
                        Nhận biết
                    </span>
                </div>

                <div class="flex items-center gap-2 sm:gap-3">
                    <div id="streak-box" class="hidden items-center gap-1 bg-orange-100 text-orange-700 border border-orange-300 px-3 py-1 rounded-xl font-extrabold text-sm">
                        <span>🔥</span> <span id="streak-count">0</span>
                    </div>
                    <div class="bg-sky-100 text-sky-900 border border-sky-300 px-3 py-1.5 rounded-xl font-black text-sm sm:text-base flex items-center gap-1.5" title="Thời gian làm bài">
                        <i class="fa-solid fa-stopwatch text-sky-600"></i>
                        <span id="timer-display">00:00</span>
                    </div>
                    <div class="bg-amber-100 text-amber-900 border border-amber-300 px-3.5 py-1.5 rounded-xl font-black text-sm sm:text-base flex items-center gap-1.5">
                        <i class="fa-solid fa-star text-amber-500"></i>
                        <span id="score-display">0</span> điểm
                    </div>
                </div>
            </div>

            <!-- Thanh tiến trình 20 câu -->
            <div>
                <div class="flex justify-between text-xs sm:text-sm font-extrabold text-slate-600 mb-1">
                    <span>Câu hỏi <span id="current-q-num" class="text-indigo-600 text-base">1</span> / 20</span>
                    <span id="progress-percent">5%</span>
                </div>
                <div class="w-full h-3 bg-slate-200 rounded-full overflow-hidden">
                    <div id="progress-bar" class="h-full bg-gradient-to-r from-indigo-500 via-purple-500 to-pink-500 rounded-full transition-all duration-300" style="width: 5%"></div>
                </div>
            </div>

            <!-- Khung câu hỏi -->
            <div class="bg-gradient-to-br from-indigo-50 via-purple-50 to-pink-50 border-2 border-indigo-200 rounded-2xl p-4 sm:p-6 shadow-inner">
                <div id="question-text" class="scalable-title font-extrabold text-slate-900 text-center">
                    <!-- Nội dung câu hỏi render bằng JS -->
                </div>
            </div>

            <!-- Khung 4 phương án trả lời (Tự động chuyển 1 cột khi Zoom lớn để không mất chữ) -->
            <div id="options-grid" class="grid grid-cols-1 md:grid-cols-2 gap-3 sm:gap-4">
                <!-- 4 nút đáp án render bằng JS -->
            </div>

            <!-- Khu vực phản hồi, Sticker chúc mừng & Lời giải chi tiết -->
            <div id="feedback-box" class="hidden rounded-2xl p-4 border-2 transition-all">
                <div class="flex flex-col sm:flex-row items-center justify-between gap-3">
                    <div class="flex items-center gap-3 text-center sm:text-left">
                        <div id="feedback-sticker" class="text-4xl sm:text-5xl animate-celebrate select-none">🎉</div>
                        <div>
                            <h4 id="feedback-title" class="font-black text-base sm:text-lg">Chính xác tuyệt vời!</h4>
                            <p id="feedback-explanation" class="scalable-explanation text-slate-700 font-semibold mt-0.5"></p>
                        </div>
                    </div>
                    <button id="next-btn" onclick="nextQuestion()" class="w-full sm:w-auto shrink-0 px-6 py-3 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-black text-base shadow-lg transition flex items-center justify-center gap-2">
                        <span>Câu tiếp theo</span> <i class="fa-solid fa-arrow-right"></i>
                    </button>
                </div>
            </div>

        </div>

        <!-- 3. MÀN HÌNH TỔNG KẾT & BẢNG XẾP HẠNG -->
        <div id="result-screen" class="hidden w-full max-w-3xl bg-white/95 backdrop-blur-md rounded-3xl shadow-2xl p-6 sm:p-8 border-4 border-white/50 text-center animate-pop">
            <div id="result-trophy" class="text-6xl sm:text-7xl mb-2 animate-celebrate inline-block">🏆</div>
            <h2 id="result-title" class="text-2xl sm:text-3xl font-black text-indigo-900 mb-1">HOÀN THÀNH XUẤT SẮC!</h2>
            <p id="result-student-name" class="text-base sm:text-lg font-extrabold text-purple-700 mb-3">Học sinh: ...</p>

            <!-- Thông báo trạng thái lưu & đồng bộ Google Sheet -->
            <div id="sync-status-banner" class="mb-4 px-4 py-2 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs sm:text-sm font-bold inline-flex items-center gap-2">
                <i class="fa-solid fa-circle-check text-emerald-600"></i>
                <span>Đã lưu kết quả vào Bảng xếp hạng!</span>
            </div>

            <!-- Bảng điểm tổng hợp -->
            <div class="grid grid-cols-3 gap-3 mb-4">
                <div class="bg-indigo-50 border-2 border-indigo-200 rounded-2xl p-3">
                    <div class="text-xs font-bold text-indigo-600 uppercase">Tổng điểm</div>
                    <div id="final-score" class="text-2xl sm:text-3xl font-black text-indigo-900">0</div>
                </div>
                <div class="bg-emerald-50 border-2 border-emerald-200 rounded-2xl p-3">
                    <div class="text-xs font-bold text-emerald-600 uppercase">Số câu đúng</div>
                    <div id="final-correct" class="text-2xl sm:text-3xl font-black text-emerald-700">0/20</div>
                </div>
                <div class="bg-amber-50 border-2 border-amber-200 rounded-2xl p-3">
                    <div class="text-xs font-bold text-amber-600 uppercase">Chuỗi đúng</div>
                    <div id="final-streak" class="text-2xl sm:text-3xl font-black text-amber-600">0 🔥</div>
                </div>
            </div>

            <!-- Chi tiết từng mức độ & thời gian -->
            <div class="bg-slate-50 border border-slate-200 rounded-2xl p-4 mb-5 grid grid-cols-2 sm:grid-cols-4 gap-2 text-xs sm:text-sm font-bold">
                <div class="text-sky-700">Thời gian: <span id="stat-time" class="font-black">00:00</span></div>
                <div class="text-emerald-700">Nhận biết: <span id="stat-nb" class="font-black">0/10</span></div>
                <div class="text-amber-700">Thông hiểu: <span id="stat-th" class="font-black">0/6</span></div>
                <div class="text-rose-700">Vận dụng: <span id="stat-vd" class="font-black">0/4</span></div>
            </div>

            <!-- BẢNG XẾP HẠNG TRỰC TIẾP NGAY SAU KHI CHƠI XONG -->
            <div class="bg-gradient-to-b from-amber-50 to-white border-2 border-amber-200 rounded-2xl p-4 mb-6 text-left shadow-inner">
                <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
                    <h3 class="font-black text-amber-900 text-base sm:text-lg flex items-center gap-2">
                        <i class="fa-solid fa-ranking-star text-amber-500"></i> BẢNG XẾP HẠNG LỚP (Đúng nhiều &rarr; Nhanh nhất)
                    </h3>
                    <button onclick="copyZaloReport()" class="px-3.5 py-1.5 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-extrabold text-xs sm:text-sm flex items-center gap-1.5 shadow transition">
                        <i class="fa-solid fa-share-nodes"></i> Copy tin nhắn gửi Zalo Phụ huynh
                    </button>
                </div>
                <div class="overflow-x-auto max-h-56 overflow-y-auto rounded-xl border border-amber-200 bg-white">
                    <table class="w-full text-left border-collapse text-xs sm:text-sm">
                        <thead class="bg-amber-100/80 text-amber-950 font-extrabold sticky top-0">
                            <tr>
                                <th class="p-2.5 text-center w-14">Hạng</th>
                                <th class="p-2.5">Họ và Tên</th>
                                <th class="p-2.5">Lớp</th>
                                <th class="p-2.5 text-center">Số câu đúng</th>
                                <th class="p-2.5 text-center">Thời gian</th>
                            </tr>
                        </thead>
                        <tbody id="result-ranking-tbody" class="divide-y divide-amber-100 font-bold text-slate-700">
                            <!-- Render tự động -->
                        </tbody>
                    </table>
                </div>
                <div id="result-toast-notify" class="hidden mt-2 text-center text-xs sm:text-sm font-extrabold text-blue-700 bg-blue-100 py-1.5 rounded-xl"></div>
            </div>

            <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
                <button onclick="backToStartForNextStudent()" class="w-full sm:w-auto px-6 py-3.5 rounded-2xl bg-gradient-to-r from-emerald-500 to-teal-600 hover:from-emerald-400 hover:to-teal-500 text-white font-black text-base shadow-lg transition flex items-center justify-center gap-2">
                    <i class="fa-solid fa-user-plus"></i> Lượt học sinh tiếp theo
                </button>
                <button onclick="openLeaderboardModal()" class="w-full sm:w-auto px-6 py-3.5 rounded-2xl bg-indigo-600 hover:bg-indigo-500 text-white font-black text-base shadow-lg transition flex items-center justify-center gap-2">
                    <i class="fa-solid fa-file-excel"></i> Xuất Google Sheet
                </button>
                <button onclick="restartSameStudent()" class="w-full sm:w-auto px-5 py-3.5 rounded-2xl bg-slate-200 hover:bg-slate-300 text-slate-800 font-extrabold text-base transition flex items-center justify-center gap-2">
                    <i class="fa-solid fa-rotate-right"></i> Làm lại
                </button>
            </div>
        </div>

    </main>

    <!-- CHÂN TRANG -->
    <footer class="text-center text-white/85 text-xs sm:text-sm py-2.5 px-4 font-semibold">
